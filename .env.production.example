# ─────────────────────────────────────────────────────────────────
# PANGI — contoh berkas .env untuk peladen produksi (Jagoan Hosting)
#
# Salin menjadi .env di peladen, lalu isi nilai yang bertanda GANTI.
# Jangan pernah menaruh berkas ini ke dalam kendali versi setelah
# diisi — ia memuat sandi basis data dan kunci aplikasi.
# ─────────────────────────────────────────────────────────────────

APP_NAME="PANGI"
APP_ENV=production
# Isi dengan hasil `php artisan key:generate --show`
APP_KEY=
APP_DEBUG=false
# GANTI dengan domain sungguhan, termasuk https bila SSL sudah aktif
APP_URL=https://pangi.poltekkes-manado.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

# Biaya hashing kata sandi. 12 aman untuk shared hosting;
# turunkan ke 10 hanya bila login terasa lambat.
BCRYPT_ROUNDS=12

# Di produksi cukup catat peringatan ke atas — debug membocorkan isi query.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Basis data (cPanel → MySQL Databases) ────────────────────────
# Nama basis data dan pengguna di cPanel selalu berawalan nama akun.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=GANTI_namaakun_pangi
DB_USERNAME=GANTI_namaakun_pangi
DB_PASSWORD=GANTI_sandi_basis_data

# ── Sesi, antrean, dan cache ─────────────────────────────────────
# Semuanya lewat basis data supaya tidak bergantung pada Redis,
# yang tidak tersedia pada paket shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true bila domain sudah memakai HTTPS.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Surel ────────────────────────────────────────────────────────
# Isi dengan akun surel cPanel; selama kosong, notifikasi hanya
# tersimpan di dalam aplikasi dan tidak dikirim ke luar.
# Biarkan "log" sampai akun surel resmi siap; SMTP yang salah setel
# membuat halaman menggantung saat notifikasi dikirim.
MAIL_MAILER=log
MAIL_HOST=mail.poltekkes-manado.ac.id
MAIL_PORT=465
MAIL_USERNAME=GANTI_alamat_surel
MAIL_PASSWORD=GANTI_sandi_surel
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="pangi@poltekkes-manado.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Asisten AI pada Dashboard Eksekutif (opsional) ───────────────
# Selama kosong, menu tetap terbuka tetapi wawasan AI nonaktif.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
